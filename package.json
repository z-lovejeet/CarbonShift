{
  "name": "carbonshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "10.34.4"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && tsx scripts/check-boundaries.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc -p contracts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:test": "hardhat test --config contracts/hardhat.config.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:grid": "tsx scripts/check-grid.ts",
    "verify:clean": "node scripts/verify-clean-install.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.1",
    "@nomicfoundation/hardhat-viem": "3.0.10",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "hardhat": "3.20.0",
    "jsdom": "27.4.0",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "viem": "2.57.7",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
