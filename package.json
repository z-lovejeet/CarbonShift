{
  "name": "carbonshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "10.34.4"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && tsx scripts/check-boundaries.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc -p contracts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:test": "hardhat test --config contracts/hardhat.config.ts && tsx scripts/receipt-artifacts.ts --check",
    "check:env": "tsx scripts/check-env.ts",
    "check:grid": "tsx scripts/check-grid.ts",
    "check:accounts": "node scripts/check-accounts.mjs",
    "check:planner": "node scripts/check-planner.mjs",
    "check:lifecycle": "node --conditions=react-server --import tsx scripts/check-lifecycle.mjs",
    "check:publication": "node --import tsx scripts/check-publication.mjs",
    "lifecycle:maintenance": "tsx scripts/lifecycle-maintenance.ts",
    "retention": "tsx scripts/retention.ts",
    "check:ai-flow": "node scripts/check-ai-flow.mjs",
    "verify:clean": "node scripts/verify-clean-install.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "ai:policy": "tsx scripts/ai-policy.ts",
    "ai:access": "tsx scripts/check-ai-access.ts",
    "ai:smoke": "node --conditions=react-server --import tsx scripts/smoke-ai.ts",
    "ai:maintenance": "tsx scripts/ai-maintenance.ts",
    "ai:evaluate-explanation": "node --conditions=react-server --import tsx scripts/evaluate-explanation.ts",
    "ai:evaluate": "node --conditions=react-server --import tsx scripts/evaluate-ai.ts",
    "proof:artifacts": "hardhat compile --config contracts/hardhat.config.ts && tsx scripts/receipt-artifacts.ts --write",
    "worker:ledger": "node --import tsx src/worker/ledger.ts",
    "ledger:reconcile": "node --import tsx src/worker/ledger.ts --reconcile-only --once",
    "contracts:deploy": "hardhat compile --config contracts/hardhat.config.ts && tsx scripts/receipt-artifacts.ts --check && node --import tsx scripts/deploy-ledger.ts",
    "check:household": "node scripts/check-household-expansion.mjs"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@js-temporal/polyfill": "0.5.1",
    "@noble/hashes": "2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "canonicalize": "5.1.0",
    "groq-sdk": "1.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.1",
    "@nomicfoundation/hardhat-viem": "3.0.10",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "hardhat": "3.20.0",
    "jsdom": "27.4.0",
    "postgres": "3.4.9",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
