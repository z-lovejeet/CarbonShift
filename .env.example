# Copy to .env.local. The foundation runs with AI/ledger disabled and no accounts.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=
PRIVACY_CONTACT=

AI_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=
AI_CONSTRAINT_PRIMARY_MODEL=gemini-4-argon
AI_CONSTRAINT_FALLBACK_MODEL=openai/gpt-oss-120b
AI_EXPLANATION_PRIMARY_MODEL=openai/gpt-oss-120b
AI_EXPLANATION_FALLBACK_MODEL=gemini-3.8-flash

LEDGER_ENABLED=false
LEDGER_CHAIN_ID=11155111
SEPOLIA_RPC_URL=
LEDGER_CONTRACT_ADDRESS=
LEDGER_DEPLOYMENT_BLOCK=
# Signing credentials belong exclusively in .env.worker.local; never add them here.
