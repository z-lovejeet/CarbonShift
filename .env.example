# Copy to .env.local. The foundation runs with AI/ledger disabled and no accounts.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=
PRIVACY_CONTACT=

AI_ENABLED=false
# UK-facing Gemini requires explicitly approved Paid Services.
# See docs/09-ai-agents-models-and-workflow.md before enabling AI for a deployment.
GEMINI_API_KEY=
GROQ_API_KEY=
# Keep disabled until account limits and model/role evaluation are verified.
# pnpm ai:policy writes a disabled policy template; it never enables AI.
AI_POLICY_JSON=
# Unset in local development. Only set after verifying the hosting proxy contract.
TRUSTED_CLIENT_IP_HEADER=

LEDGER_ENABLED=false
LEDGER_CHAIN_ID=11155111
SEPOLIA_RPC_URL=
LEDGER_CONTRACT_ADDRESS=
LEDGER_DEPLOYMENT_BLOCK=
# Signing credentials belong exclusively in .env.worker.local; never add them here.
